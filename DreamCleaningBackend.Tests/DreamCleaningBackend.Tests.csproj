<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test projects are self-hosting executables on Microsoft Testing Platform
         (global.json selects that runner for dotnet test). -->
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <!-- Lets the input-builder tests run against a real ApplicationDbContext without MariaDB.
         Version must match the EF Core version the API project uses (10.0.x). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DreamCleaningBackend\DreamCleaningBackend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated from the frontend calculator; the cross-surface test reads it at runtime. -->
    <Content Include="pricing-fixtures.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
