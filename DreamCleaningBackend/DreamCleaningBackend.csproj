<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.4" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.12" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
    <PackageReference Include="RingCentral.Net" Version="6.6.4" />
    <PackageReference Include="Stripe.net" Version="53.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
    <!-- JsonWebTokenHandler issues and reads the app's own tokens. Protocols.OpenIdConnect is listed only
         so every Microsoft.IdentityModel.* assembly (JwtBearer brings 8.19.x) resolves to ONE version. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="Telegram.Bot" Version="22.10.3.2" />
  </ItemGroup>
	<ItemGroup>
		<Content Include="Migrations/**/*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<!-- Branding embedded in generated contract PDFs. Must ship with the app rather than live
		     under the uploads root, which is publicly served and admin-writable. -->
		<Content Include="Assets/**/*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

  <!-- Prevent accidental build output folders inside project from being compiled -->
  <ItemGroup>
    <Compile Remove="bin-build-temp\**\*.cs" />
    <Content Remove="bin-build-temp\**\*.*" />
    <None Remove="bin-build-temp\**\*.*" />
  </ItemGroup>
</Project>
